# Sample .env for WorkoutBuddy Backend
# Copy this file to `.env` and fill real secrets. DO NOT commit your real `.env` file.

# MongoDB
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
DB_NAME=workoutbuddy

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# Session / app secrets
SESSION_SECRET_KEY=<random-session-secret>
SECRET_KEY=<secret-key-for-jwt-or-framework>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Fernet (encryption) key (base64)
FERNET_KEY=<fernet-key-base64>

# Frontend / API
FRONTEND_BASEURL=http://127.0.0.1:8001
API_SECRET=<api-secret-or-passphrase>

# Email (use app password for Gmail)
FROM_EMAIL=you@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=<email-password-or-app-password>

# GROQ / other API keys
GROQ_API_KEY=<groq-api-key>

# Notes:
# - Replace each `<placeholder>` with real values in your local `.env`.
# - Add `.env` to your `.gitignore` to avoid committing secrets.
# - For Gmail, generate an app password if 2FA is enabled and use it in EMAIL_PASS.
